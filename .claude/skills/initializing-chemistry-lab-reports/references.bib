% References.bib template for chemistry lab reports
% Use ACS citation style (chem-acs)
% Add your references below in BibTeX format

% Example: PubChem entry
@misc{pubchem_example,
  author = {{PubChem Compound Summary}},
  title = {Compound Name},
  url = {https://pubchem.ncbi.nlm.nih.gov/compound/XXXXX},
  publisher = {National Center for Biotechnology Information},
  year = {2026},
  note = {accessed \today}
}

% Example: Wikipedia entry (use sparingly, prefer primary sources)
@misc{wikipedia_example,
  author = {{Wikipedia}},
  title = {Article Title},
  url = {https://en.wikipedia.org/wiki/Article_Title},
  year = {2026},
  note = {accessed \today}
}

% Example: Journal article
@article{journal_example,
  author = {Lastname, Firstname and Lastname, Firstname},
  title = {Article Title},
  journal = {Journal Name},
  volume = {00},
  number = {0},
  pages = {000--000},
  year = {2026},
  doi = {10.xxxx/xxxxx}
}

% Example: Textbook
@book{textbook_example,
  author = {Lastname, Firstname},
  title = {Textbook Title},
  publisher = {Publisher},
  year = {2026},
  edition = {0},
  address = {City}
}

